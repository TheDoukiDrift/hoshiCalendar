{
    "id": "naviCalendar",
    "name": "Navi Calendar",
    "description": "Calendar desktop widget and bar widget with .ics support (local files and remote/webcal feeds)",
    "version": "1.2.0",
    "author": "TheDoukiDrift",
    "type": "composite",
    "capabilities": ["desktop-widget", "dankbar-widget", "calendar", "monitoring"],
    "icon": "calendar_month",
    "components": {
        "daemon": "./CalendarDaemon.qml",
        "widget": "./BarWidget.qml",
        "desktop": "./DesktopWidget.qml"
    },
    "settings": "./Settings.qml",
    "requires_dms": ">=1.5.0",
    "dependencies": ["curl"],
    "permissions": ["settings_read", "settings_write", "process", "network"]
}
